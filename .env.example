# ==============================================================================
# Brickify SecurityOS - AI/ML Detector Configuration Template
# ==============================================================================
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info
BASE_PATH=/detect

# YOLO Configuration
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45

# Plate Recognition Fine-Tuning
PLATE_MIN_CONFIDENCE=0.2
PLATE_MIN_WIDTH=50
PLATE_MIN_HEIGHT=15
PLATE_ASPECT_RATIO_MIN=1.5
PLATE_ASPECT_RATIO_MAX=8.0

# Load Estimation Parameters
LOAD_IOU_THRESHOLD=0.10
LOAD_MIN_ITEM_CONFIDENCE=0.20
LOAD_VISUAL_EMPTY_THRESHOLD=0.05
LOAD_VISUAL_FULL_THRESHOLD=0.40

# Infrastructure
REDIS_URL=redis://localhost:6379
CACHE_TTL=900
JOB_TTL=3600
SAAS_FREE_DAILY_LIMIT=100

# Video Resolve Settings
YOUTUBE_RESOLVER_ENABLED=True
YT_DLP_TIMEOUT_SECONDS=20
STREAM_RESOLVE_CACHE_TTL=600
VIDEO_SOURCE_REQUIRE_API_KEY=False
